<% items ||= [] %>
<% position ||= "bottom" %>
<% variant ||= "default" %>
<% show_mobile = local_assigns.fetch(:show_mobile, true) %>
<% classes ||= nil %>

<%
  # Determine tooltip placement based on position
  tooltip_placement = position.to_s == "bottom" ? "top" : "bottom"

  # Build wrapper classes
  base_wrapper = "flex w-fit mx-auto items-center justify-center"
  wrapper_classes = [base_wrapper, classes].compact.reject(&:empty?).join(" ")

  # Build dock container classes
  base_dock = "mx-auto hidden h-16 gap-4 bg-neutral-50 px-4 md:flex dark:bg-neutral-950 border border-neutral-200/50 dark:border-neutral-600/50 shadow-sm"
  position_class = position.to_s == "bottom" ? "items-end pb-3" : "items-start pt-3"

  variant_class = case variant.to_s
                  when "pill"
                    "rounded-full"
                  when "rounded"
                    "rounded-xl"
                  else
                    "rounded-2xl"
                  end

  dock_container_classes = [base_dock, position_class, variant_class].join(" ")
%>

<div class="<%= wrapper_classes %>" data-controller="dock">
  <%# Desktop dock %>
  <nav aria-label="Dock" class="<%= dock_container_classes %>">
    <% items.each do |item| %>
      <%= render "shared/components/dock/dock_item",
        url: item[:url],
        tooltip: item[:tooltip],
        icon: item[:icon],
        hotkey: item[:hotkey],
        active: item[:active] || false,
        tooltip_placement: tooltip_placement,
        item_classes: item[:classes]
      %>
    <% end %>
  </nav>

  <% if show_mobile %>
    <%# Frosted glow behind the open mobile menu, fading out from the bottom-right corner %>
    <div class="pointer-events-none absolute -right-8 -bottom-8 hidden md:hidden w-[calc(min(34rem,120vw)+2rem)] h-[calc(min(40rem,85dvh)+2rem)] origin-bottom-right opacity-0 will-change-transform backdrop-blur-[6px] bg-[radial-gradient(farthest-side_at_100%_100%,rgb(250_250_250/0.94)_0%,rgb(250_250_250/0.8)_55%,rgb(250_250_250/0)_100%)] dark:bg-[radial-gradient(farthest-side_at_100%_100%,rgb(23_23_23/0.94)_0%,rgb(23_23_23/0.8)_55%,rgb(23_23_23/0)_100%)] [mask-image:radial-gradient(farthest-side_at_100%_100%,#000_55%,transparent_100%)]" data-dock-target="mobileGlow"></div>

    <%# Mobile menu (expanded items) %>
    <nav aria-label="Dock" class="absolute right-5 bottom-17 flex items-end flex-col gap-2 hidden md:hidden" data-dock-target="mobileMenu">
      <% items.each do |item| %>
        <%= render "shared/components/dock/dock_item_mobile",
          url: item[:url],
          tooltip: item[:tooltip],
          icon: item[:icon],
          active: item[:active] || false
        %>
      <% end %>
    </nav>

    <%# Mobile toggle button %>
    <div class="absolute right-5 bottom-5 block md:hidden">
      <button type="button" data-dock-target="mobileButton" data-action="click->dock#toggleMobile" aria-expanded="false" aria-label="Menu" class="flex size-10 items-center justify-center rounded-full border border-neutral-400/50 dark:border-neutral-500/50 text-neutral-500 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-950 shadow-[0_1px_2px_rgb(0_0_0/0.06),0_4px_12px_-2px_rgb(0_0_0/0.14)] aria-expanded:shadow-[0_2px_4px_rgb(0_0_0/0.08),0_14px_32px_-6px_rgb(0_0_0/0.3)] dark:shadow-[0_1px_2px_rgb(0_0_0/0.4),0_8px_20px_-6px_rgb(0_0_0/0.6)] dark:aria-expanded:shadow-[0_2px_4px_rgb(0_0_0/0.5),0_14px_32px_-6px_rgb(0_0_0/0.8)] transition-[box-shadow,scale] duration-300 ease-out active:scale-92 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-600 dark:focus-visible:outline-neutral-300">
        <svg class="size-5 rotate-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><g fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" stroke="currentColor"><polyline points="2.75 11.5 9 5.25 15.25 11.5"></polyline></g></svg>
      </button>
    </div>
  <% end %>
</div>
