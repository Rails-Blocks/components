<a href="<%= url %>" class="relative rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-600 dark:focus-visible:outline-neutral-300" aria-label="<%= tooltip %>" <%= tag.attributes(data: data_attributes.merge(hotkey_data_attributes)) %>>
  <div class="<%= icon_box_classes %>">
    <div class="flex items-center justify-center *:size-full" style="width: 50%; height: 50%" aria-hidden="true">
      <%= icon_content %>
    </div>
  </div>
</a>
