<div class="<%= wrapper_classes %>" <%= tag.attributes(controller_data) %>>
  <%# Desktop dock %>
  <nav aria-label="Dock" class="<%= dock_container_classes %>">
    <% items.each do |item| %>
      <%= item %>
    <% end %>
  </nav>

  <% if show_mobile? %>
    <div class="<%= mobile_glow_classes %>" data-dock-target="mobileGlow"></div>

    <%# Mobile menu (expanded items) %>
    <nav aria-label="Dock" class="<%= mobile_menu_classes %>" data-dock-target="mobileMenu">
      <% items.each do |item| %>
        <%= item.render_mobile %>
      <% end %>
    </nav>

    <%# Mobile toggle button %>
    <div class="absolute right-5 bottom-5 block md:hidden">
      <button type="button" data-dock-target="mobileButton" data-action="click->dock#toggleMobile" aria-expanded="false" aria-label="Menu" class="<%= mobile_button_classes %>">
        <%= chevron_svg %>
      </button>
    </div>
  <% end %>
</div>
